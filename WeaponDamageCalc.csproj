<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PackerTfm Condition="'$(PackerTfm)' == ''">$(TargetFramework)</PackerTfm>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.2.0.0</Version>
    <FileVersion>1.2.0.0</FileVersion>

    <PublishSingleFile>true</PublishSingleFile>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebuggerSupport>false</DebuggerSupport>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <NoWarn>$(NoWarn);IL2008</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <Target Name="PublishStub" BeforeTargets="Publish" Condition="'$(Packer)' == 'managed' And '$(SelfContained)' != 'true' And '$(Configuration)' != 'Debug'">
    <Exec Command="dotnet publish &quot;$(ProjectDir)Lamarr&quot; -c $(Configuration) -r $(RuntimeIdentifier) --no-self-contained -p:PublishSingleFile=true -p:LamarrTfm=$(TargetFramework) -p:DebugType=none -p:DebugSymbols=false -p:Version=$(FileVersion) -p:FileVersion=$(FileVersion) -p:InformationalVersion=$(FileVersion) -p:AssemblyVersion=1.0.0.0 -p:IncludeSourceRevisionInInformationalVersion=false -o &quot;$(PublishDir)&quot;" />
    <Exec Command="dotnet build &quot;$(ProjectDir)Lamarr\Packer&quot; -c $(Configuration) -p:PackerTfm=$(PackerTfm)" />
  </Target>

  <Target Name="LamarrPack" AfterTargets="Publish" Condition="'$(Packer)' == 'managed' And '$(SelfContained)' != 'true' And '$(Configuration)' != 'Debug'">
    <Exec Command="&quot;$(ProjectDir)Lamarr\Packer\bin\$(Configuration)\$(PackerTfm)\LamarrPacker.exe&quot; --pack --stub &quot;$(PublishDir)Lamarr.exe&quot; --input &quot;$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\win-x64\$(AssemblyName).dll&quot; --output &quot;$(PublishDir)$(AssemblyName)_packed.exe&quot; --mode managed" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)_packed.exe" DestinationFiles="$(PublishDir)$(AssemblyName).exe" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(PublishDir)$(AssemblyName)_packed.exe" />
  </Target>

  <ItemGroup>
    <Compile Remove="Lamarr\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="Lamarr\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="weapons.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Tools\preset_file.txt" />
    <EmbeddedResource Include="Demo\keil.fc" />
  </ItemGroup>

  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <TrimmerRootAssembly Include="System.Windows.Forms" />
  </ItemGroup>

  <Target Name="RemoveWpfNativeDlls" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
      <ItemGroup>
          <Cor3Dlls Include="$(PublishDir)*_cor3.dll" />
      </ItemGroup>
      <Delete Files="@(Cor3Dlls)" />
  </Target>

  <Import Project="Lamarr\Native\PayloadPack.targets" />

</Project>
