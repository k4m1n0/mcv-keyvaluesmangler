<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.2.0.0</Version>
    <FileVersion>1.2.0.0</FileVersion>

    <PublishSingleFile>true</PublishSingleFile>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebuggerSupport>false</DebuggerSupport>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <NoWarn>$(NoWarn);IL2008</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup>
    <Packer Condition="'$(Packer)' == ''">managed</Packer>
    <BootName Condition="'$(BootName)' == ''">WeaponDamageCalc.Boot</BootName>
    <BootTfm Condition="'$(BootTfm)' == ''">net8.0-windows</BootTfm>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == '' And ('$(Packer)' == 'native' Or '$(Packer)' == 'antheil')">
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <Target Name="PublishStub" BeforeTargets="Publish" Condition="'$(Packer)' == 'managed' And '$(SelfContained)' != 'true' And '$(Configuration)' != 'Debug'">
    <Exec Command="dotnet publish &quot;$(ProjectDir)Lamarr&quot; -c $(Configuration) -r $(RuntimeIdentifier) --no-self-contained -p:PublishSingleFile=true -p:DebugType=none -p:DebugSymbols=false -o &quot;$(PublishDir)&quot;" />
    <Exec Command="dotnet build &quot;$(ProjectDir)Lamarr\Packer&quot; -c $(Configuration)" />
  </Target>

  <Target Name="LamarrPack" AfterTargets="Publish" Condition="'$(Packer)' == 'managed' And '$(SelfContained)' != 'true' And '$(Configuration)' != 'Debug'">
    <Exec Command="&quot;$(ProjectDir)Lamarr\Packer\bin\$(Configuration)\net8.0-windows\LamarrPacker.exe&quot; --stub &quot;$(PublishDir)Lamarr.exe&quot; --input &quot;$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\win-x64\WeaponDamageCalc.dll&quot; --output &quot;$(PublishDir)WeaponDamageCalc_packed.exe&quot;" />
    <Copy SourceFiles="$(PublishDir)WeaponDamageCalc_packed.exe" DestinationFiles="$(PublishDir)WeaponDamageCalc.exe" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(PublishDir)WeaponDamageCalc_packed.exe" />
  </Target>

  <Target Name="NativeStubPack" AfterTargets="Publish" Condition="'$(Packer)' == 'native' Or '$(Packer)' == 'antheil'">
    <Delete Files="$(PublishDir)WeaponDamageCalc.exe" />
    <Exec Command="dotnet publish &quot;$(ProjectDir)WeaponDamageCalc.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) --no-self-contained -p:PublishSingleFile=true -p:Packer=none -o &quot;$(PublishDir)&quot;" Condition="'$(SelfContained)' != 'true'" />
    <Exec Command="dotnet build &quot;$(ProjectDir)Lamarr\Native\Native.csproj&quot; -c Release -v q" />
    <Exec Command="dotnet build &quot;$(ProjectDir)Lamarr\Native\BootAntheil\Boot.csproj&quot; -c Release -p:BootName=$(BootName) -p:BootTfm=$(BootTfm) -v q" Condition="'$(Packer)' == 'antheil'" />
    <Exec Command="dotnet build &quot;$(ProjectDir)Lamarr\Native\Boot\Boot.csproj&quot; -c Release -v q" Condition="'$(Packer)' == 'native'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Lamarr\Native\build_asm.ps1&quot; -AsmDir &quot;$(ProjectDir)Lamarr\Native&quot; -OutDir &quot;$(ProjectDir)Lamarr\Native\out&quot; -Packer antheil -Pack -InputPath &quot;$(PublishDir)WeaponDamageCalc.exe&quot; -Output &quot;$(PublishDir)WeaponDamageCalc_packed.exe&quot; -Boot &quot;$(ProjectDir)Lamarr\Native\BootAntheil\bin\Release\$(BootTfm)\$(BootName).dll&quot; -Decoder &quot;$(ProjectDir)Lamarr\Native\out\Iamdec.dll&quot; -JitHook &quot;$(ProjectDir)Lamarr\Native\out\jithook.dll&quot; -Pheropod &quot;$(ProjectDir)Lamarr\Native\out\z0.dll&quot; -Mode antheil" Condition="'$(Packer)' == 'antheil'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Lamarr\Native\build_asm.ps1&quot; -AsmDir &quot;$(ProjectDir)Lamarr\Native&quot; -OutDir &quot;$(ProjectDir)Lamarr\Native\out&quot; -Packer native -Pack -InputPath &quot;$(PublishDir)WeaponDamageCalc.exe&quot; -Output &quot;$(PublishDir)WeaponDamageCalc_packed.exe&quot; -Boot &quot;$(ProjectDir)Lamarr\Native\Boot\bin\Release\net8.0-windows\LamarrBoot.dll&quot; -Mode clean" Condition="'$(Packer)' == 'native'" />
    <Copy SourceFiles="$(PublishDir)WeaponDamageCalc_packed.exe" DestinationFiles="$(PublishDir)WeaponDamageCalc.exe" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(PublishDir)WeaponDamageCalc_packed.exe" />
  </Target>

  <ItemGroup>
    <Compile Remove="Lamarr\**" />
    <Compile Remove="publish\**" />
    <Compile Remove="PeWriter.cs" />
    <EmbeddedResource Remove="Lamarr\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="weapons.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Tools\preset_file.txt" />
    <EmbeddedResource Include="Demo\keil.fc" />
  </ItemGroup>

  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <TrimmerRootAssembly Include="System.Windows.Forms" />
  </ItemGroup>

  <Target Name="RemoveWpfNativeDlls" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
      <ItemGroup>
          <Cor3Dlls Include="$(PublishDir)*_cor3.dll" />
      </ItemGroup>
      <Delete Files="@(Cor3Dlls)" />
  </Target>

</Project>
