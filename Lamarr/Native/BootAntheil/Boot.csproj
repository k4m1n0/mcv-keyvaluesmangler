<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BootTfm Condition="'$(BootTfm)'==''">net8.0-windows</BootTfm>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(BootTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BootName Condition="'$(BootName)'==''">LamarrBoot</BootName>
    <AssemblyName>$(BootName)</AssemblyName>
    <RootNamespace>BootHost</RootNamespace>
    <LangVersion>latest</LangVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StackTraceSupport>false</StackTraceSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>
</Project>