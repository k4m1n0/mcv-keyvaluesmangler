<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BootTfm Condition="'$(BootTfm)'==''">net8.0-windows</BootTfm>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(BootTfm)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LamarrBoot</AssemblyName>
    <RootNamespace>LamarrBoot</RootNamespace>
    <Version>1.0.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\LamarrDecoder.cs" Link="LamarrDecoder.cs" />
  </ItemGroup>
</Project>
