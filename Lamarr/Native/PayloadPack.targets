<Project>
  <PropertyGroup>
    <LamarrNativeDir>$(MSBuildThisFileDirectory)</LamarrNativeDir>
    <LamarrPackerDir>$(MSBuildThisFileDirectory)..\Packer\</LamarrPackerDir>
    <LamarrAsmDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).').TrimEnd('\'))</LamarrAsmDir>
    <LamarrRepoRoot>$(MSBuildThisFileDirectory)..\..\</LamarrRepoRoot>
    <Packer Condition="'$(Packer)' == ''">managed</Packer>
    <BootName Condition="'$(BootName)' == ''">$(AssemblyName).Boot</BootName>
    <BootTfm Condition="'$(BootTfm)' == ''">$(TargetFramework)</BootTfm>
    <ShimName Condition="'$(ShimName)' == ''">$(AssemblyName).Host</ShimName>
    <ShimConfig Condition="'$(ShimConfig)' == ''">Release</ShimConfig>
    <ShimDll Condition="'$(ShimDll)' == ''">$(LamarrNativeDir)ShimAntheil\bin\$(ShimConfig)\$(BootTfm)\$(ShimName).dll</ShimDll>
    <ShimVersion Condition="'$(ShimVersion)' == ''">$(FileVersion)</ShimVersion>
    <ShimVersion Condition="'$(ShimVersion)' == ''">$(Version)</ShimVersion>
    <ShimVersion Condition="'$(ShimVersion)' == '' Or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ShimVersion)', '^[0-9]+(\.[0-9]+){1,3}$'))">1.0.0.0</ShimVersion>
    <ShimProduct Condition="'$(ShimProduct)' == ''">$(AssemblyName)</ShimProduct>
    <LamarrShimArg Condition="'$(LamarrNoEntryLayer)' != '1'">-Shim &quot;$(ShimDll)&quot;</LamarrShimArg>
    <PackerTfm Condition="'$(PackerTfm)' == ''">$(TargetFramework)</PackerTfm>
    <LamarrAntheilInnerArg Condition="'$(Packer)' == 'antheil'">-p:LamarrAntheil=1</LamarrAntheilInnerArg>
    <LamarrSeed Condition="'$(LamarrSeed)' == '' And '$(Packer)' == 'antheil'">$([System.Guid]::NewGuid().ToString().Replace("-", "").Substring(0,16))</LamarrSeed>
    <LamarrSeed Condition="'$(LamarrSeed)' == '' And '$(Packer)' != 'antheil'">5EED000100000000</LamarrSeed>
    <PayloadMajor Condition="'$(PayloadMajor)' == ''">$([System.Text.RegularExpressions.Regex]::Match('$(TargetFramework)', '[0-9]+').Value)</PayloadMajor>
    <LamarrSeedArg Condition="'$(Packer)' == 'antheil'">-Seed &quot;$(LamarrSeed)&quot;</LamarrSeedArg>
    <EngineDll Condition="'$(EngineDll)' == ''">$(LamarrNativeDir)out\engine.dll</EngineDll>
    <RtcTiered Condition="'$(RtcTiered)' == ''">default</RtcTiered>
    <LamarrTriageKnobs Condition="'$(LamarrTriageKnobs)' == ''"></LamarrTriageKnobs>
    <LamarrTriageKnobsArg Condition="'$(LamarrTriageKnobs)' == '1'">-TriageKnobs</LamarrTriageKnobsArg>
    <LamarrTriageKnobsInnerArg Condition="'$(LamarrTriageKnobs)' == '1'">-p:LamarrTriageKnobs=1</LamarrTriageKnobsInnerArg>
    <LamarrRuntimePackArg Condition="'$(EnableRuntimePackDownload)' != ''">-p:EnableRuntimePackDownload=$(EnableRuntimePackDownload)</LamarrRuntimePackArg>
    <LamarrNoMorphArg Condition="'$(LamarrNoMorph)' == '1'">-NoMorph</LamarrNoMorphArg>
    <LamarrNoCompressDepsArg Condition="'$(NoCompressDeps)' != ''">-NoCompressDeps &quot;$(NoCompressDeps)&quot;</LamarrNoCompressDepsArg>
    <LamarrEscrowPlainArg Condition="'$(LamarrEscrowPlain)' == '1'">-EscrowPlain</LamarrEscrowPlainArg>
    <LamarrEscrowArg Condition="'$(LamarrEscrow)' != ''">-Escrow &quot;$(LamarrEscrow)&quot; $(LamarrEscrowPlainArg)</LamarrEscrowArg>
    <LamarrReplayArg Condition="'$(LamarrReplay)' != ''">-Replay &quot;$(LamarrReplay)&quot;</LamarrReplayArg>
    <RtcVersion Condition="'$(RtcVersion)' == ''">$(PayloadMajor).0.0</RtcVersion>
    <RtcRollForward Condition="'$(RtcRollForward)' == ''"></RtcRollForward>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LamarrTriageKnobs)' == '1'">
    <DefineConstants>$(DefineConstants);LAMARR_TRIAGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(LamarrTriageKnobs)' != '1'">
    <Compile Remove="Form1.Liveness.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SelfContained)' == '' And ('$(Packer)' == 'native' Or '$(Packer)' == 'antheil')">
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <Target Name="NativeStubPack" AfterTargets="Publish" Condition="'$(Packer)' == 'native' Or '$(Packer)' == 'antheil'">
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r $(RuntimeIdentifier) --no-self-contained --no-restore -p:PublishSingleFile=true -p:Packer=none -p:TargetFramework=$(TargetFramework) -p:AssemblyName=$(AssemblyName) -p:TargetName=$(TargetName) $(LamarrTriageKnobsInnerArg) $(LamarrRuntimePackArg) -o &quot;$(PublishDir)&quot;" Condition="'$(SelfContained)' != 'true'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)pe.ps1&quot; -ClearCet -Path &quot;$(PublishDir)$(AssemblyName).exe&quot;" Condition="'$(SelfContained)' != 'true'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)build_asm.ps1&quot; -AsmDir &quot;$(LamarrAsmDir)&quot; -OutDir &quot;$(LamarrNativeDir)out&quot; -Packer $(Packer) $(LamarrTriageKnobsArg) $(LamarrNoMorphArg) $(LamarrSeedArg)" />
    <RemoveDir Directories="$(LamarrPackerDir)bin\Release\$(PackerTfm);$(LamarrPackerDir)obj\Release\$(PackerTfm)" ContinueOnError="true" />
    <Error Condition="Exists('$(LamarrPackerDir)bin\Release\$(PackerTfm)\LamarrPacker.exe')" Text="packer wipe failed: LamarrPacker.exe survived the RemoveDir, the build would reuse a stale packer (file locked?)" />
    <Exec Command="dotnet build &quot;$(LamarrPackerDir)Packer.csproj&quot; -c Release -v q -p:PackerTfm=$(PackerTfm) $(LamarrAntheilInnerArg)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)pe.ps1&quot; -ClearCet -Path &quot;$(LamarrPackerDir)bin\Release\$(PackerTfm)\LamarrPacker.exe&quot;" />
    <RemoveDir Directories="$(LamarrNativeDir)BootAntheil\bin\Release\$(BootTfm);$(LamarrNativeDir)BootAntheil\obj\Release\$(BootTfm)" ContinueOnError="true" Condition="'$(Packer)' == 'antheil'" />
    <Error Condition="'$(Packer)' == 'antheil' And Exists('$(LamarrNativeDir)BootAntheil\bin\Release\$(BootTfm)\$(BootName).dll')" Text="boot wipe failed: $(BootName).dll survived the RemoveDir, the build would reuse a stale boot image (file locked?)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)build_boot.ps1&quot; -Build -BootName $(BootName) -BootTfm $(BootTfm) $(LamarrTriageKnobsArg) -Win32Res &quot;$(LamarrNativeDir)out\empty.res&quot;" Condition="'$(Packer)' == 'antheil'" />
    <Exec Command="dotnet build &quot;$(LamarrNativeDir)ShimAntheil\ShimAntheil.csproj&quot; -c $(ShimConfig) -v q -p:ShimTfm=$(BootTfm) -p:ShimName=$(ShimName) -p:Version=$(ShimVersion) -p:FileVersion=$(ShimVersion) -p:Product=$(ShimProduct) -p:Company=$(ShimProduct) -p:AssemblyTitle=$(ShimProduct) -p:EnableRuntimePackDownload=false -p:Win32Resource=&quot;$(LamarrNativeDir)out\empty.res&quot;" Condition="'$(Packer)' == 'antheil'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)pe.ps1&quot; -Residue -Path &quot;$(ShimDll)&quot; -Quiet" Condition="'$(Packer)' == 'antheil'" />
    <RemoveDir Directories="$(LamarrNativeDir)Boot\bin\Release\$(BootTfm);$(LamarrNativeDir)Boot\obj\Release\$(BootTfm)" ContinueOnError="true" Condition="'$(Packer)' == 'native'" />
    <Error Condition="'$(Packer)' == 'native' And Exists('$(LamarrNativeDir)Boot\bin\Release\$(BootTfm)\LamarrBoot.dll')" Text="boot wipe failed: LamarrBoot.dll survived the RemoveDir, the build would reuse a stale boot image (file locked?)" />
    <Exec Command="dotnet build &quot;$(LamarrNativeDir)Boot\Boot.csproj&quot; -c Release -v q -p:BootTfm=$(BootTfm)" Condition="'$(Packer)' == 'native'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)build_engine.ps1&quot; -OutDir &quot;$(LamarrNativeDir)out&quot; -Seed $(LamarrSeed) -Prod -PackerTfm $(PackerTfm)" Condition="'$(Packer)' == 'antheil'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)build_asm.ps1&quot; -AsmDir &quot;$(LamarrAsmDir)&quot; -OutDir &quot;$(LamarrNativeDir)out&quot; -Packer antheil -Pack -InputPath &quot;$(PublishDir)$(AssemblyName).exe&quot; -Output &quot;$(PublishDir)$(AssemblyName)_packed.exe&quot; -Boot &quot;$(LamarrNativeDir)BootAntheil\bin\Release\$(BootTfm)\$(BootName).dll&quot; $(LamarrShimArg) -Decoder &quot;$(LamarrNativeDir)out\Iamdec.dll&quot; -JitHook &quot;$(LamarrNativeDir)out\jithook.dll&quot; -Pheropod &quot;$(LamarrNativeDir)out\z0.dll&quot; -Engine &quot;$(EngineDll)&quot; $(LamarrSeedArg) -AppName $(AssemblyName) -PackerTfm $(PackerTfm) -RtcRollForward &quot;$(RtcRollForward)&quot; -EncryptDeps &quot;$(EncryptDeps)&quot; $(LamarrNoCompressDepsArg) $(LamarrEscrowArg) $(LamarrReplayArg) -Mode antheil" Condition="'$(Packer)' == 'antheil'" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LamarrNativeDir)build_asm.ps1&quot; -AsmDir &quot;$(LamarrAsmDir)&quot; -OutDir &quot;$(LamarrNativeDir)out&quot; -Packer native -Pack -InputPath &quot;$(PublishDir)$(AssemblyName).exe&quot; -Output &quot;$(PublishDir)$(AssemblyName)_packed.exe&quot; -Boot &quot;$(LamarrNativeDir)Boot\bin\Release\$(BootTfm)\LamarrBoot.dll&quot; -PackerTfm $(PackerTfm) -RtcRollForward &quot;$(RtcRollForward)&quot; $(LamarrSeedArg) -Mode clean -StubVersion &quot;$(FileVersion)&quot;" Condition="'$(Packer)' == 'native'" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)_packed.exe" DestinationFiles="$(PublishDir)$(AssemblyName).exe" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(PublishDir)$(AssemblyName)_packed.exe" />
  </Target>
</Project>